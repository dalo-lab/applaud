# Applaud — FieldOps fork environment
# Copy to .env and populate. chmod 600 .env before first run.

# Plaud JWT token — extract from Chrome localStorage on plaud.ai
# Expires ~10 months from issue date. Knox has the refresh SOP.
# NOTE: In Docker, token is set via the web UI at http://localhost:44471/setup
#       (browser auto-detect does not work inside a container). This var is
#       informational only — the server reads it from settings.json, not the env.
PLAUD_JWT=

# Webhook secret — generate with: openssl rand -hex 32
# Must match APPLAUD_WEBHOOK_SECRET in FieldOps Flask app.
# Applied at startup via applyEnvOverrides() in server/src/index.ts.
APPLAUD_WEBHOOK_SECRET=

# Webhook target URL — where Applaud POSTs transcript_ready events.
# Default points to local FieldOps Flask app on port 8090.
# Applied at startup via applyEnvOverrides() in server/src/index.ts.
# NOTE: env var name in the server code is APPLAUD_WEBHOOK_URL.
APPLAUD_WEBHOOK_URL=http://host.docker.internal:8090/webhook/applaud

# Config directory — where settings.json and state.sqlite are stored.
# Mapped to /data/config inside the container via the volume mount.
# Dockerfile sets this to /data/config; override only if you remap the volume.
APPLAUD_CONFIG_DIR=/data/config

# Data path — where Applaud writes audio + transcript files.
# In Docker, recordings land in /data/recordings (inside the /data volume).
# This is set via the web UI wizard (Settings > Recordings folder) after first run.
# The docker-compose.yml mounts ${HOME}/applaud-data as /data on the host.
APPLAUD_DATA_PATH=/data

# Log level — pino log level (trace|debug|info|warn|error). Default: info.
LOG_LEVEL=info
